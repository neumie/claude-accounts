{
	"manifest_version": 3,
	"name": "Claude accounts",
	"version": "0.1.0",
	"description": "Switch between your claude.ai accounts in one window; artifact links switch to the account that can open them.",
	"key": "",
	"minimum_chrome_version": "120",
	"incognito": "not_allowed",
	"permissions": ["storage", "cookies", "declarativeNetRequestWithHostAccess"],
	"host_permissions": ["https://claude.ai/*"],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Claude accounts"
	},
	"content_scripts": [
		{
			"matches": ["https://claude.ai/*"],
			"js": ["content.js"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
	}
}
