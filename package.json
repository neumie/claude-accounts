{
	"name": "claude-accounts",
	"version": "0.1.0",
	"private": true,
	"description": "Chrome extension: switch claude.ai accounts in one window; artifact links switch to the account that can open them",
	"type": "module",
	"scripts": {
		"build": "node build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.ts",
		"check": "npm run typecheck && npm test && npm run build"
	},
	"engines": {
		"node": ">=23.6"
	},
	"dependencies": {
		"solid-js": "^1.9.19"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@babel/preset-typescript": "^7.29.7",
		"@rollup/plugin-babel": "^7.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@types/chrome": "^0.3.7",
		"@types/node": "^26.6.6",
		"babel-preset-solid": "^1.9.19",
		"rollup": "^4.68.3",
		"typescript": "^5.9.3"
	}
}
